# 1 = демо: любой хост, без входа, локальный файл data/demo.sqlite
# 0 = своя MySQL и OAuth Twitch/Kick
DEMO_MODE=1

# Настройки базы данных (нужны только при DEMO_MODE=0)
DB_HOST=localhost
DB_NAME=groznyhub
DB_USER=root
DB_PASSWORD=

# Twitch OAuth (только при DEMO_MODE=0)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Kick OAuth (привязка аккаунта на сайте)
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
KICK_DB_HOST=localhost
KICK_DB_NAME=groznyhub_kick
KICK_DB_USER=root
KICK_DB_PASS=

# User access token владельца канала (не BOT_TOKEN): scope channel:manage:redemptions
# Для команды !staff также нужны scope: moderation:read и channel:read:vips
# Тот же TWITCH_CLIENT_ID, что у приложения в dev.twitch.tv
TWITCH_BROADCASTER_TOKEN=

# Настройки таймера
INACTIVITY_TIMEOUT=420

# Как часто опрашивать Twitch Helix о статусе стрима (секунды)
STREAM_CHECK_INTERVAL=30

# Если Helix недоступен, но в чате есть сообщения — считать стрим «живым» (секунды)
STREAM_CHAT_ACTIVITY_SECONDS=900

# Доп. каналы IRC для коллаба / общего чата (через запятую, с # или без)
# EXTRA_CHANNELS=#other_streamer

# Настройки капчи
CAPTCHA_TIMEOUT=300

# Стоимость кейса в секундах (5400 = 90 минут рефки)
CASE_COST_SECONDS=5400

# Длительность баннера продажи в секундах
CASE_SALE_DURATION_SECONDS=30

# Джекпот времени
JACKPOT_DURATION_SECONDS=120
JACKPOT_DRAW_DELAY_SECONDS=10
JACKPOT_MIN_BET_SECONDS=600
JACKPOT_DEFAULT_BET_SECONDS=1800
JACKPOT_HOUSE_BANK_SECONDS=86400
# 1 = рулетка только во время стрима; 0 = можно играть оффлайн (по умолчанию)
JACKPOT_REQUIRE_STREAM=0
JACKPOT_MAX_NUMBERS_PER_PLAYER=3

# Дуэль контейнеров (!контейнер в чате, только во время стрима)
CONTAINERS_MIN_BET_SECONDS=1800
CONTAINERS_DEFAULT_BET_SECONDS=1800
CONTAINERS_COOLDOWN_SECONDS=600
CONTAINERS_WIN_MULTIPLIER=2
CONTAINER_GOVT_CUT_PERCENT=20

# Как часто пробовать вернуться с SQLite на MySQL (секунды)
MYSQL_RECONNECT_INTERVAL=60

# 0 = не переключаться на локальную SQLite (рекомендуется на проде: время только в MySQL)
DB_SQLITE_FALLBACK=0

# Ежедневный бонус (!бонус) — часовой пояс для «сегодня»
DAILY_BONUS_TIMEZONE=Europe/Moscow

# Часовой пояс naive DATETIME из MySQL (created_at и т.д.)
DB_TIMEZONE=Europe/Moscow

# Мягкая защита от накрутки рефки (одинаковые сообщения)
REFKA_ANTISPAM_ENABLED=1
SPAM_REPEAT_COUNT=8
SPAM_REPEAT_WINDOW=1200
SPAM_WARN_BEFORE_PAUSE=4
SPAM_WARN_BEFORE_STOP=6
SPAM_PAUSE_SECONDS=300
SPAM_MIN_MSG_LEN=6
SPAM_WARNING_COOLDOWN=180
SPAM_GOOD_MESSAGES_FORGIVE=12

# Розыгрыш по кодовому слову (!розыгрыш)
# RAFFLE_RESPONSE_SECONDS=60      # больше не используется — лимит решает стример
RAFFLE_MATCH_MODE=contains        # contains или exact

# Кто может передавать своё время другим (!отдать) — через запятую, lowercase login
TIME_GIFT_ALLOWED_LOGINS=

# Адрес сайта берётся из текущего запроса, отдельно прописывать домен не нужно.

# Секрет для Paper-плагина GroznyHub-Whitelist (заголовок X-GroznyHub-Key)
# Сгенерируйте длинную случайную строку и укажите ту же в plugins/GroznyHub-Whitelist/config.yml
LAUNCHER_WHITELIST_KEY=

# DeepSeek — короткие фразы для озвучки виджета контейнеров (голос: Web Speech в браузере OBS)
# DEEPSEEK_API_KEY=
# DEEPSEEK_API_BASE=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# Голос озвучки контейнеров (Edge TTS / Google fallback, для микшера OBS)
# TTS_PROVIDER=auto     auto | edge | google
# TTS_VOICE=ru-RU-DmitryNeural
# TTS_VOICE=ru-RU-SvetlanaNeural

# Пожертвование на продление сайта/бота (Boosty)
# SITE_DONATE_URL=https://boosty.to/helperforradmir/single-payment/donation/809580/target?share=target_link
